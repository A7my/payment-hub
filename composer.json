{
    "name": "a7my/payment-hub",
    "description": "Enterprise-grade provider-agnostic payment framework for Laravel 10+",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "payment",
        "payment-gateway",
        "payment-framework",
        "stripe",
        "paypal",
        "paymob",
        "myfatoorah"
    ],
    "authors": [
        {
            "name": "Mifatoyeh",
            "email": "dev@mifatoyeh.com"
        }
    ],
    "homepage": "https://github.com/A7my/payment-hub",
    "support": {
        "issues": "https://github.com/A7my/payment-hub/issues",
        "source": "https://github.com/A7my/payment-hub"
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0",
        "stripe/stripe-php": "^13.0|^14.0|^15.0|^16.0|^17.0|^18.0|^19.0|^20.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "innmind/black-box": "^5.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Mifatoyeh\\LaravelPaymentFramework\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mifatoyeh\\LaravelPaymentFramework\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mifatoyeh\\LaravelPaymentFramework\\Providers\\PaymentServiceProvider"
            ],
            "aliases": {
                "Payment": "Mifatoyeh\\LaravelPaymentFramework\\Facades\\Payment"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
